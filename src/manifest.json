{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.4.4",
  "author": "tedvask",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "tb-chat@tedvask.github.io",
      "strict_min_version": "153.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "message_display_scripts": [
    {
      "js": [
        "content/style.js",
        "content/chat.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options/options.html"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesModify",
    "messagesUpdate",
    "compose",
    "compose.send",
    "storage"
  ]
}
